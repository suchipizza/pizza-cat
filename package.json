{
  "name": "pizza-cat",
  "version": "1.0.0",
  "private": true,
  "description": "A small, forkable character engine for animated GitHub profile SVGs. Food may escape.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
